# Copiar a .env (en esta misma carpeta) y completar con las credenciales del
# cliente OAuth2 emitidas para este consumidor (ver /clients en el modulo de
# administracion del api-middleware-service).

MW_BASE_URL=http://localhost:3007
MW_CLIENT_ID=mc_xxxxxxxxxxxx
MW_CLIENT_SECRET=changeme
MW_SCOPE=read

# Intervalo de polling en milisegundos (default 300000 = 5 minutos) —
# controla cada cuanto se corre el ciclo, NO cuanto historial trae cada
# consulta (eso es MW_LOOKBACK_DAYS, abajo).
MW_POLL_INTERVAL_MS=300000

# Cuantos dias hacia atras pedir en dateFrom (default 1). Independiente del
# intervalo de polling — con una ventana de minutos casi siempre da 0
# resultados porque rara vez hay una cita creada/actualizada en un margen
# tan chico. dateTo siempre es el fin del dia actual.
MW_LOOKBACK_DAYS=1

# Opcional. Ruta a un certificado CA a confiar puntualmente (ej: el
# autofirmado de un staging propio, mismo archivo que usa Apache en
# SSLCertificateFile). NO desactiva la verificacion TLS para otros
# certificados — solo agrega este a la lista de confianza.
# MW_CA_CERT_PATH=../dashboard/deploy/certs/fullchain.pem

# Opcional, PELIGROSO. Desactiva por completo la verificacion de certificado
# TLS (equivalente a "SSL certificate verification: OFF" en Postman) — el
# poller acepta cualquier certificado de cualquier servidor, exponiendo el
# client_secret a un posible ataque MITM. Usar solo para pruebas puntuales
# y aisladas; preferir MW_CA_CERT_PATH siempre que se pueda.
# MW_INSECURE_SKIP_TLS_VERIFY=true
