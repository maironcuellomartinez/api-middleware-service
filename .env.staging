# ── Server ────────────────────────────────────────────────────────────────────
PORT=3007
NODE_ENV=staging

# ── Base de datos (MySQL staging) ────────────────────────────────────────────
DB_HOST=mysql-staging
DB_PORT=3306
DB_USERNAME=CHANGE_ME
DB_PASSWORD=CHANGE_ME
DB_DATABASE=middleware_db

# ── JWT (firma de tokens para clientes externos) ──────────────────────────────
JWT_SECRET=CHANGE_ME
JWT_EXPIRATION=3600

# ── Admin API ─────────────────────────────────────────────────────────────────
ADMIN_API_KEY=CHANGE_ME

# ── API Gateway ───────────────────────────────────────────────────────────────
API_GATEWAY_URL=http://api-gateway:3000

# ── ABAC M2M — token para llamadas al api-gateway ────────────────────────────
ABAC_M2M_TOKEN=CHANGE_ME

# ── CORS ──────────────────────────────────────────────────────────────────────
CORS_ALLOWED_ORIGINS=https://staging.eventcorner.com

# ── Bulkhead HTTP entrante ────────────────────────────────────────────────────
HTTP_BULKHEAD_CONCURRENCY=30
HTTP_BULKHEAD_MAX_QUEUE=60
